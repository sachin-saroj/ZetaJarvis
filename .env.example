# ============================================================================
# ZetaJarvis Environment Configuration Example
# ============================================================================
# इस फ़ाइल को .env के रूप में copy करें और अपनी values भरें:
#   cp .env.example .env    (Linux/macOS)
#   copy .env.example .env  (Windows)

# ============================================================================
# LLM Configuration (Required)
# ============================================================================

# API Key - Your LLM service (OpenRouter / OpenAI compatible gateway)
JARVIS_API_KEY=your-openrouter-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Base URL - Gateway address (defaults to OpenRouter)
JARVIS_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Multi-Model Fallback Chain
MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_SECONDARY=meta-llama/llama-3.3-70b-instruct:free
MODEL_TERTIARY=deepseek/deepseek-r1:free
FALLBACK_CHAIN=nvidia/nemotron-3-ultra-550b-a55b:free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free

# Quota & Token Management (Free-Tier Optimization)
DAILY_TOKEN_QUOTA=100000
TOKEN_TRUNCATION_THRESHOLD=3000
SOFT_TOKEN_LIMIT=4096
MAX_HISTORY=20
TOOLS_CONFIG_PATH=tools_config.json

# Jitter & Concurrency Configuration
MAX_PARALLEL_TOOLS=3
MAX_TOOL_RETRIES=2
MAX_MODEL_RETRIES=3
JITTER_BASE_SEC=1.0
JITTER_MAX_SEC=30.0

# ============================================================================
# Speech Recognition (ASR) Settings
# ============================================================================

# Whisper Model Size (tiny/base/small/medium/large-v3)
JARVIS_WHISPER=small

# ASR Language setting
# For Indian users speaking both English and Hindi/Hinglish (code-switching), 
# it is highly recommended to leave this empty/auto (JARVIS_LANGUAGE=) or set to "auto".
# Whisper's auto-detect handles code-switching much better than forcing a single fixed language.
# Only specify a fixed language (like "en" or "hi") if you exclusively speak one language to it.
JARVIS_LANGUAGE=

# ASR Beam Search (1=fastest, 5=most accurate)
JARVIS_ASR_BEAM=5

# ============================================================================
# iFlytek Cloud Recognition (Optional)
# ============================================================================

# JARVIS_XFYUN_APPID=your-xfyun-appid
# JARVIS_XFYUN_APIKEY=your-xfyun-apikey
# JARVIS_XFYUN_APISECRET=your-xfyun-apisecret

# ============================================================================
# Text-to-Speech Settings
# ============================================================================

# TTS Backend (gptsovits/clone/say)
JARVIS_TTS=say

# GPT-SoVITS API URL
GPTSOVITS_URL=http://127.0.0.1:9880

# ============================================================================
# Desktop Domination Layer Settings
# ============================================================================

# Stealth & HUD
HUD_TRANSPARENCY=0.85
HUD_HOTKEY_TOGGLE=ctrl+alt+z
HUD_HOTKEY_FORCE_KILL=ctrl+alt+k
TYPEWRITER_CPS=45.0
STEALTH_MODE=false

# Stealth Harness
DIAG_ENCRYPTION_KEY=
PANIC_PHRASE=Zeta, lockdown
DIAG_LOG_ROTATION_LINES=5000

# ============================================================================
# Enterprise Resilience & Digital Worker Node Settings
# ==============================================================================

# Startup Persistence & Guardian
AUTO_STARTUP_ENABLED=true
PERSISTENCE_APP_NAME=ZetaJarvis
PERSISTENCE_TASK_NAME=ZetaJarvisKeepAlive
GUARDIAN_MAX_RESTARTS=10
GUARDIAN_COOLDOWN_SEC=1.0

# UI Automation
SCREENSHOTS_DIR=screenshots
ABORT_AUTOMATION_PHRASE=Zeta, abort automation

# Zero-Downtime Self-Updater
UPDATE_REPO=origin
UPDATE_BRANCH=main
UPDATE_CHECK_HOURS=1.0
MAX_BACKUPS_RETAINED=5

# ============================================================================
# Production Release & Governance Settings
# ==============================================================================

# Resource Governance (Governor)
GOVERNOR_CPU_HIGH=85.0
GOVERNOR_RAM_HIGH=90.0
GOVERNOR_CPU_LOW=40.0
GOVERNOR_RAM_LOW=60.0
GOVERNOR_CPU_EMERGENCY=95.0
GOVERNOR_EMERGENCY_DURATION=30.0

# Log Rotation & Retention
LOG_MAX_SIZE_MB=10.0
LOG_RETENTION_DAYS=30
LOG_CHECK_INTERVAL_SEC=300.0

